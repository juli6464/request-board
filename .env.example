# Variables para docker compose (copiar a .env en la raíz del repo).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_ENABLED=true
DB_ROOT_PASSWORD=secret
# Puerto MySQL expuesto en el host (3307 para no chocar con XAMPP).
DB_PORT_HOST=3307
# Puertos en el host para la API (Laravel) y la SPA (nginx).
API_PORT_HOST=8000
WEB_PORT_HOST=8080
