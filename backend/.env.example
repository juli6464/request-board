APP_NAME="Request Board"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Workers del servidor embebido: evita que una llamada lenta al LLM bloquee el listado.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos (MySQL). Con XAMPP: root sin contraseña. ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=request_board
DB_USERNAME=root
DB_PASSWORD=

# La API es stateless: no necesita tablas de sesión/caché en BD.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# --- LLM (Groq, API compatible con OpenAI) ---
# Sin GROQ_API_KEY o con LLM_ENABLED=false, /summary/llm responde 200 con fallback.
LLM_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
